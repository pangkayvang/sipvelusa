/* ===== Velusa Brand Variables ===== */
:root {
    --blush: #f7e9e6;
    --cream: #fdfaf6;
    --rose-gold: #c9a39a;
    --matte-wood: #f3f0eb;
    --ink: #2a2a2a;
    --accent: #e8d4cf;
    --shadow-soft: rgba(0,0,0,0.08);
}

/* ===== Global ===== */
body {
    margin: 0;
    padding: 0;
    background: var(--cream);
    font-family: "Inter", sans-serif;
    color: var(--ink);
}

/* ===== Header ===== */
.velusa-header {
    text-align: center;
    padding: 40px 0;
}

.velusa-logo {
    width: 120px;
    filter: drop-shadow(0px 2px 4px var(--shadow-soft));
}

.brand-title {
    font-size: 32px;
    letter-spacing: 2px;
    margin-top: 10px;
    color: var(--rose-gold);
    font-weight: 600;
}

/* ===== Hero ===== */
.hero {
    background: var(--blush);
    padding: 80px 20px;
    text-align: center;
}

.hero-title {
    font-size: 40px;
    font-weight: 600;
    color: var(--ink);
}

.hero-sub {
    font-size: 18px;
    color: var(--rose-gold);
    margin-top: 10px;
}

/* ===== Menu Sections ===== */
.menu-section {
    padding: 60px 20px;
}

.section-title {
    font-size: 28px;
    text-align: center;
    margin-bottom: 40px;
    color: var(--rose-gold);
}

/* ===== Menu Grid ===== */
.menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 30px;
    padding: 0 20px;
}

.menu-card {
    background: var(--matte-wood);
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0px 4px 12px var(--shadow-soft);
    text-align: center;
    transition: transform 0.2s ease;
}

.menu-card:hover {
    transform: translateY(-4px);
}

.menu-img {
    width: 100%;
    border-radius: 14px;
    margin-bottom: 15px;
    box-shadow: 0px 3px 8px var(--shadow-soft);
}

.menu-name {
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
}

.menu-desc {
    font-size: 14px;
    color: var(--rose-gold);
    margin-top: 6px;
}
